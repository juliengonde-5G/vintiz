# Database
POSTGRES_USER=vintiz
POSTGRES_PASSWORD=vintiz_dev_2026
POSTGRES_DB=vintiz
DATABASE_URL=postgresql+asyncpg://vintiz:vintiz_dev_2026@db:5432/vintiz

# Redis
REDIS_URL=redis://redis:6379/0

# Security
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In development, an ephemeral key is generated automatically if left blank.
SECRET_KEY=
# Dedicated immutable fiscal HMAC key. Generate independently from SECRET_KEY;
# never rotate it without first creating a final fiscal archive.
FISCAL_SIGNING_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Admin bootstrap key (only used by /api/admin/create-tables)
# Distinct from SECRET_KEY so leaking the JWT signing key doesn't grant table-create access.
ADMIN_BOOTSTRAP_KEY=

# Login rate limit (per client IP)
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Anthropic
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
# Set to true in production to emit JSON lines for log shippers (Loki, Datadog, ELK)
LOG_JSON=false

# SumUp (CB payment terminal). No in-app simulation: leave keys empty to make
# card payment fail closed, or use a real/test SumUp key against their API.
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Optional: target a specific SumUp Solo terminal to push payments directly.
# Find the reader id via GET /v0.1/merchants/{MERCHANT_CODE}/readers.
# When set, the TPE rings automatically on "Carte (CB)" — no re-entry.
SUMUP_READER_ID=
# Optional: webhook/return URL appended to reader payloads.
SUMUP_RETURN_URL=

# -----------------------------------------------
# HARDWARE — printers (overrides hardware.json on first boot)
# -----------------------------------------------
# Receipt printer (MUNBYN 047P-WiFi, ESC/POS, port 9100)
RECEIPT_PRINTER_HOST=
RECEIPT_PRINTER_PORT=9100

# Label printer (Zebra ZD421d, ZPL II, port 9100)
# Set ZEBRA_PRINTER_IP to the printer's LAN address. The legacy
# LABEL_PRINTER_HOST/PORT variables are still read as a fallback so
# existing deployments don't break on upgrade.
ZEBRA_PRINTER_IP=
ZEBRA_PRINTER_PORT=9100

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# -----------------------------------------------
# WALLET — Google Wallet (Save-to-Google JWT)
# -----------------------------------------------
# Tant que ces clés ne sont pas posées, l'API renvoie un payload "preview"
# + QR code fallback ; le bouton "Ajouter à Google Wallet" est masqué côté front.
#
# Pré-requis :
#   WALLET_GOOGLE_ISSUER_ID            : 19 chiffres (Google Pay & Wallet console)
#   WALLET_GOOGLE_CLASS_SUFFIX         : suffix de la LoyaltyClass (défaut vintiz_loyalty)
#   WALLET_GOOGLE_SERVICE_ACCOUNT_JSON : chemin absolu vers le JSON du Service Account
WALLET_GOOGLE_ISSUER_ID=
WALLET_GOOGLE_CLASS_SUFFIX=vintiz_loyalty
WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------
# WALLET — Apple Wallet (.pkpass) — DÉSACTIVÉ
# -----------------------------------------------
# Abonnement Apple Developer non actif → on garde la conf en commentaire.
# Tant que ces lignes restent commentées, le bouton "Ajouter à Apple Wallet"
# est automatiquement masqué côté front et l'endpoint /account/wallet/apple
# renvoie 503. Décommente + remplis quand l'abonnement Apple Dev est renouvelé.
#
# WALLET_PASS_TYPE_IDENTIFIER=pass.fr.vintiz.loyalty
# WALLET_TEAM_IDENTIFIER=ABCDE12345
# WALLET_APPLE_P12_PATH=
# WALLET_APPLE_P12_PASSWORD=
# WALLET_APPLE_WWDR_PATH=
# WALLET_PASS_ASSETS_DIR=
