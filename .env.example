# Database
POSTGRES_USER=vintiz
POSTGRES_PASSWORD=vintiz_dev_2026
POSTGRES_DB=vintiz
DATABASE_URL=postgresql+asyncpg://vintiz:vintiz_dev_2026@db:5432/vintiz

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Anthropic
ANTHROPIC_API_KEY=

# SumUp (CB payment terminal)
# SUMUP_ENVIRONMENT: sandbox | production (default: sandbox when no API key)
# In sandbox mode: no real API call, events visible in Settings > Paiement.
SUMUP_ENVIRONMENT=sandbox
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
# Delay in seconds before a sandbox PENDING checkout auto-flips to PAID.
# Set to 0 to require manual approval from the admin UI.
SUMUP_SANDBOX_AUTO_DELAY_SEC=5

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3001
