{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "_doc": "Vintiz typography v2: Lexend Mega for headlines (display), Poppins for body. Both available on Google Fonts. Variables --font-display + --font-body should be set on :root from next/font.",
  "fonts": {
    "display": {
      "family": "Lexend Mega",
      "fallback": ["Poppins", "system-ui", "sans-serif"],
      "weights": [400, 500, 600, 700],
      "css_var": "--font-display"
    },
    "body": {
      "family": "Poppins",
      "fallback": ["system-ui", "sans-serif"],
      "weights": [300, 400, 500, 600, 700],
      "css_var": "--font-body"
    }
  },
  "scale": {
    "_doc": "Tailwind text- utilities used in Vintiz UI. line-height defaults to 1.5 for body text and 1.2 for display.",
    "xs": { "size": "0.75rem", "line_height": "1rem" },
    "sm": { "size": "0.875rem", "line_height": "1.25rem" },
    "base": { "size": "1rem", "line_height": "1.5rem" },
    "lg": { "size": "1.125rem", "line_height": "1.75rem" },
    "xl": { "size": "1.25rem", "line_height": "1.75rem" },
    "2xl": { "size": "1.5rem", "line_height": "2rem" },
    "3xl": { "size": "1.875rem", "line_height": "2.25rem" },
    "4xl": { "size": "2.25rem", "line_height": "2.5rem" }
  },
  "tracking": {
    "_doc": "Letter-spacing tokens — uppercase labels use 'wider', display uses default.",
    "tight": "-0.025em",
    "normal": "0em",
    "wide": "0.025em",
    "wider": "0.05em"
  }
}
