{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "_doc": "Vintiz Charte v3 — typographie Sauge Néo (2026-04). Remplace v2 (Lexend Mega + Poppins).",
  "font": {
    "display": {
      "$value": "Fraunces",
      "$type": "fontFamily",
      "$description": "Display serif — opsz 9-144, weights 400/450/500. Fallback: Söhne Breit, Cormorant Garamond, serif."
    },
    "body": {
      "$value": "Manrope",
      "$type": "fontFamily",
      "$description": "Body sans — weights 300/400/500/600/700. Fallback: Söhne, system-ui, sans-serif."
    },
    "mono": {
      "$value": "JetBrains Mono",
      "$type": "fontFamily",
      "$description": "Monospaced — weights 400/500. Pour numéros, codes, références. Fallback: ui-monospace, monospace."
    }
  },
  "scale": {
    "hero": {
      "$value": { "size": "64px", "lineHeight": "1", "letterSpacing": "-0.015em", "fontWeight": "450", "mobile": "38px" },
      "$type": "typography"
    },
    "h1": {
      "$value": { "size": "40px", "lineHeight": "1.05", "letterSpacing": "-0.01em", "fontWeight": "500", "mobile": "28px" },
      "$type": "typography"
    },
    "h2": {
      "$value": { "size": "28px", "lineHeight": "1.15", "fontWeight": "500", "mobile": "22px" },
      "$type": "typography"
    },
    "body": {
      "$value": { "size": "16px", "lineHeight": "1.55", "mobile": "14px" },
      "$type": "typography"
    },
    "caption": {
      "$value": { "size": "11px", "letterSpacing": "0.12em", "textTransform": "uppercase" },
      "$type": "typography"
    },
    "mono": {
      "$value": { "size": "13px", "mobile": "11px" },
      "$type": "typography"
    }
  }
}
