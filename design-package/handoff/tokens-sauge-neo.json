{
  "$schema": "https://json.schemastore.org/design-tokens.json",
  "_doc": "Vintiz Charte v3 — direction Sauge Néo (2026-04). Remplace v2 (Lexend Mega + teal #006A5A + rose pastel). Le rose magenta sert d'accent éditorial (célébration, fidélité), plus de rose de remplissage.",
  "color": {
    "bg": { "$value": "#F6F5F1", "$type": "color" },
    "bg-alt": { "$value": "#ECEAE3", "$type": "color" },
    "surface": { "$value": "#FFFFFF", "$type": "color" },
    "ink": { "$value": "#0E0E0C", "$type": "color" },
    "ink-soft": { "$value": "#4A4A47", "$type": "color" },
    "ink-mute": { "$value": "#8B8B86", "$type": "color" },
    "line": { "$value": "#D5D3CC", "$type": "color" },
    "teal": {
      "DEFAULT": { "$value": "#0B7A6A", "$type": "color" },
      "deep": { "$value": "#054238", "$type": "color" },
      "soft": { "$value": "#CDE5DF", "$type": "color" }
    },
    "accent": {
      "DEFAULT": { "$value": "#E84E8B", "$type": "color" },
      "soft": { "$value": "#FFD5E5", "$type": "color" }
    },
    "gold": { "$value": "#8E7B57", "$type": "color" }
  },
  "font": {
    "display": { "$value": "Fraunces", "$type": "fontFamily" },
    "body": { "$value": "Manrope", "$type": "fontFamily" },
    "mono": { "$value": "JetBrains Mono", "$type": "fontFamily" }
  },
  "radius": {
    "sm": { "$value": "8px", "$type": "dimension" },
    "lg": { "$value": "16px", "$type": "dimension" },
    "pill": { "$value": "999px", "$type": "dimension" }
  },
  "shadow": {
    "soft": { "$value": "0 1px 0 rgba(14,14,12,0.04), 0 16px 40px -20px rgba(14,14,12,0.16)", "$type": "shadow" }
  }
}
