# ---------- build stage ----------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY apps/api/pyproject.toml apps/api/README.md* ./
RUN pip install --no-cache-dir --prefix=/install .

COPY apps/api/ ./

# ---------- runtime stage ----------
FROM python:3.11-slim AS runtime

WORKDIR /app

# Keep packaging tooling patched as well: scanners inspect the full runtime
# image even though the application never invokes pip after the build.
RUN python -m pip install --no-cache-dir --upgrade pip

# postgresql-client provides pg_dump for the nightly database backup
# (gestionnaire de base de données). The backup service degrades gracefully
# (failed row + alert email) if it is ever missing or version-mismatched.
RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system app && adduser --system --ingroup app app

COPY --from=builder /install /usr/local
COPY --from=builder /build /app

# Include seed script so it is available inside the container
COPY scripts/ /app/scripts/

# Create the upload + data dirs BEFORE chown + before the named volumes mount
# on top of them. A Docker named volume inherits the ownership of the image
# directory on first init; without these the volumes would be created
# root-owned and the non-root `app` user couldn't write — product photos would
# silently 500 (uploads/) and runtime settings (Brevo keys, hardware config in
# data/app_config.json + data/hardware.json) would be lost. See the
# `uploads_data` / `vintiz_data` volumes in docker-compose.prod.yml.
RUN mkdir -p /app/uploads /app/data && chown -R app:app /app

# Build provenance — exposé par GET /api/health (build_sha / build_date) pour
# vérifier d'un coup d'œil quelle version tourne réellement en prod. Passés en
# --build-arg par scripts/deploy.sh ; valent "unknown" en build local.
ARG VINTIZ_BUILD_SHA=unknown
ARG VINTIZ_BUILD_DATE=unknown
ENV VINTIZ_BUILD_SHA=$VINTIZ_BUILD_SHA \
    VINTIZ_BUILD_DATE=$VINTIZ_BUILD_DATE

USER app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
