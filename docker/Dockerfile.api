# ---------- build stage ----------
FROM python:3.11-slim AS builder

WORKDIR /build

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

COPY apps/api/pyproject.toml apps/api/README.md* ./
RUN pip install --no-cache-dir --prefix=/install .

COPY apps/api/ ./

# ---------- runtime stage ----------
FROM python:3.11-slim AS runtime

WORKDIR /app

RUN addgroup --system app && adduser --system --ingroup app app

COPY --from=builder /install /usr/local
COPY --from=builder /build /app

# Include seed script so it is available inside the container
COPY scripts/ /app/scripts/

# Create the product-photo upload dir BEFORE chown + before the named volume
# mounts on top of it. A Docker named volume mounted at /app/uploads inherits
# the ownership of this image directory on first init; without it the volume
# would be created root-owned and the non-root `app` user could not write
# (uploads would silently 500). See docker-compose.prod.yml `uploads_data`.
RUN mkdir -p /app/uploads && chown -R app:app /app
USER app

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
