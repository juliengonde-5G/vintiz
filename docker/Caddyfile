# Vintiz - Reverse proxy configuration
# vintiz.fr → Site vitrine (landing page)
# app.vintiz.fr → Back-office PWA
# api.vintiz.fr → API FastAPI

vintiz.fr {
	reverse_proxy site:3001
}

www.vintiz.fr {
	redir https://vintiz.fr{uri} permanent
}

app.vintiz.fr {
	reverse_proxy web:3000
}

api.vintiz.fr {
	reverse_proxy api:8000
}

# Matomo — mesure d'audience cookieless (exemptée CNIL).
# Caddy transmet X-Forwarded-For : Matomo doit être configuré pour faire
# confiance au proxy (config.ini.php : proxy_client_headers +
# proxy_host_headers + trusted_hosts) afin d'anonymiser la vraie IP visiteur.
analytics.vintiz.fr {
	reverse_proxy matomo:80
}
