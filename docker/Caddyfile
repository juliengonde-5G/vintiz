# Vintiz - Reverse proxy configuration
# vintiz.fr → Site vitrine (landing page)
# app.vintiz.fr → Back-office PWA
# api.vintiz.fr → API FastAPI

# Cibles = NOMS DE CONTENEURS (vintiz-web, vintiz-api…), jamais les noms de
# services (web, api…) : ce Caddy est attaché à deux réseaux (vintiz-network
# et fripco-network) et la pile Frip & Co Street nomme aussi ses services
# `web` et `api`. Avec les noms de services, le DNS Docker peut résoudre
# `web` vers fripco-web et servir l'autre application sur app.vintiz.fr.
vintiz.fr {
	reverse_proxy vintiz-site:3001
}

www.vintiz.fr {
	redir https://vintiz.fr{uri} permanent
}

app.vintiz.fr {
	reverse_proxy vintiz-web:3000
}

api.vintiz.fr {
	reverse_proxy vintiz-api:8000
}

# Matomo — mesure d'audience cookieless (exemptée CNIL).
# Caddy transmet X-Forwarded-For : Matomo doit être configuré pour faire
# confiance au proxy (config.ini.php : proxy_client_headers +
# proxy_host_headers + trusted_hosts) afin d'anonymiser la vraie IP visiteur.
analytics.vintiz.fr {
	reverse_proxy vintiz-matomo:80
}

# Frip & Co Street — caisse isolée (stack voisine /opt/fripco-street).
# Caddy est le SEUL composant partagé : il est rattaché au réseau externe
# `fripco-network` (docker-compose.prod.yml) et n'y fait que du proxy.
# Front sur /, API sous /api/* : une seule origine, pas de CORS.
# Caddy ≥ 2.5 remplace tout X-Forwarded-For entrant par l'IP réelle du client
# (aucun `trusted_proxies` déclaré) : l'API peut donc utiliser sa première
# valeur pour le rate-limit de connexion et le journal (JET).
app.lloomi.fr {
	encode gzip
	handle /api/* {
		reverse_proxy fripco-api:8000
	}
	handle {
		reverse_proxy fripco-web:3000
	}
}
