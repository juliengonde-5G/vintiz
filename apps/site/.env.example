# Public site — variables d'environnement

# URL canonique du site (utilisée dans metadata, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vintiz.fr

# Backend API (pour proxy /api/subscribe côté client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Analytics 4 — format G-XXXXXXXXXX
# Non défini = pas de marqueur GA injecté.
# Si défini, GA se charge uniquement APRÈS consentement (Consent Mode v2).
NEXT_PUBLIC_GA_ID=

# Google Search Console — code de vérification HTML meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
