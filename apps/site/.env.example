# Public site — variables d'environnement

# URL canonique du site (utilisée dans metadata, sitemap, robots, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://vintiz.fr

# Backend API (pour proxy /api/subscribe côté client)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mesure d'audience PRIMAIRE — Matomo cookieless (exempté de consentement CNIL).
# URL de l'instance + identifiant de site. Non défini = pas de mesure Matomo.
# L'instance DOIT être réglée en mesure d'audience exemptée : anonymisation IP,
# pas de suivi cross-site, pas de partage des données. Voir
# docs/COMPLIANCE_TRACKING_PIXELS_2026.md.
NEXT_PUBLIC_MATOMO_URL=
NEXT_PUBLIC_MATOMO_SITE_ID=

# Google Analytics 4 (LEGACY) — format G-XXXXXXXXXX
# Non défini = pas de marqueur GA injecté (état recommandé après migration Matomo).
# Si défini, GA se charge uniquement APRÈS consentement (Consent Mode v2) et
# fait apparaître le bandeau cookies + le lien « Gérer les cookies ».
NEXT_PUBLIC_GA_ID=

# Google Search Console — code de vérification HTML meta tag
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
