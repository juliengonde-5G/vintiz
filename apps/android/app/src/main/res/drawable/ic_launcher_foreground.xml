<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground du launcher icon : logo Vintiz (monogramme VZ teal sur
  fond transparent). Le canvas adaptive icon est 108x108 dp avec un
  safe zone central de 66x66 dp ; on inset le bitmap pour le caler
  dans le safe zone et éviter que la mask circulaire / squircle du
  launcher Android rogne le monogramme.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="20%">
    <bitmap android:src="@drawable/vintiz_logo"
        android:gravity="center" />
</inset>
