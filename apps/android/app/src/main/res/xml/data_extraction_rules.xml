<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : règles d'extraction de données. On exclut le JWT
     chiffré, la DB Room et les préférences DataStore — par sécurité,
     rien de sensible ne doit migrer via cloud backup ou device-to-device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vintiz_secure_prefs.xml" />
        <exclude domain="database" path="vintiz.db" />
        <exclude domain="database" path="vintiz.db-shm" />
        <exclude domain="database" path="vintiz.db-wal" />
        <exclude domain="file" path="datastore/vintiz_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vintiz_secure_prefs.xml" />
        <exclude domain="database" path="vintiz.db" />
        <exclude domain="file" path="datastore/vintiz_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
