<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <!-- Réseau LAN boutique : MUNBYN ESC/POS port 9100, Zebra ZD421d
         port 9100. Communication directe en clair (pas de TLS sur
         imprimantes thermiques RJ-45). Le bloc est cantonné aux IP
         privées RFC 1918 pour ne pas autoriser le cleartext en dehors
         du LAN. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.0</domain>
        <domain includeSubdomains="false">192.168.0.0</domain>
        <domain includeSubdomains="false">172.16.0.0</domain>
    </domain-config>
</network-security-config>
