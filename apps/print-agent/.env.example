# Vintiz label print agent — Raspberry Pi configuration
# Copy to /etc/vintiz-print-agent.env and fill in the values, then:
#   sudo systemctl restart vintiz-print-agent

# Base URL of the Vintiz API (no trailing slash).
VINTIZ_API_URL=https://app.vintiz.fr

# Shared secret — must equal RPI_AGENT_TOKEN set on the server.
# Generate once with: python3 -c "import secrets; print(secrets.token_hex(32))"
RPI_AGENT_TOKEN=

# CUPS queue name to print to (run `lpstat -p` to list). Leave empty to use the
# system default printer (set with `lpoptions -d <name>`).
CUPS_PRINTER=vintiz_labels

# Polling cadence and batch size.
POLL_INTERVAL=5
BATCH_MAX=5

# Physical label size — used to build the `lp -o media=Custom.WxHmm` option.
LABEL_WIDTH_MM=25
LABEL_HEIGHT_MM=52

# Optional overrides:
# LP_MEDIA=Custom.25x52mm           # full media string (overrides the W/H above)
# LP_EXTRA_OPTIONS=orientation-requested=3  # extra `-o` options, space-separated
# PRINT_TIMEOUT=30
# LOG_LEVEL=INFO
