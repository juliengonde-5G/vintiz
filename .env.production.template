# ===========================================
# Vintiz V3 — Template de configuration production
# ===========================================
# INSTRUCTIONS:
#   1. Copier ce fichier : cp .env.production.template .env
#   2. Remplir TOUTES les valeurs CHANGER_MOI
#   3. Ne JAMAIS commiter le fichier .env dans git
#   4. Stocker une copie chiffree offline (ex: Bitwarden, 1Password)
#
# Generer SECRET_KEY : openssl rand -hex 32

# -----------------------------------------------
# BASE DE DONNEES (PostgreSQL)
# -----------------------------------------------
POSTGRES_USER=vintiz
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort_64chars
POSTGRES_DB=vintiz
DATABASE_URL=postgresql+asyncpg://vintiz:CHANGER_MOI_mot_de_passe_fort_64chars@db:5432/vintiz

# -----------------------------------------------
# CACHE (Redis)
# -----------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------
# SECURITE JWT
# Generer avec : openssl rand -hex 32
# -----------------------------------------------
SECRET_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------
# APPLICATION
# -----------------------------------------------
APP_ENV=production
CORS_ORIGINS=https://vintiz.fr,https://app.vintiz.fr,https://api.vintiz.fr

# -----------------------------------------------
# URLS PUBLIQUES (Next.js — build-time args)
# -----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vintiz.fr
NEXT_PUBLIC_API_URL=https://api.vintiz.fr

# -----------------------------------------------
# IA — ANTHROPIC CLAUDE (OBLIGATOIRE pour IA Booster)
# Obtenir sur : https://console.anthropic.com/
# Sans cette cle : fallback sur donnees statiques
# -----------------------------------------------
ANTHROPIC_API_KEY=CHANGER_MOI_sk-ant-api03-xxxxx

# -----------------------------------------------
# METEO VERNON — OPENWEATHERMAP (recommande)
# Obtenir sur : https://openweathermap.org/api
# Plan gratuit suffisant (60 req/min)
# Sans cette cle : widget meteo indisponible
# -----------------------------------------------
OPENWEATHER_API_KEY=CHANGER_MOI_cle_openweathermap

# -----------------------------------------------
# PAIEMENT CB — SUMUP (optionnel)
# Obtenir sur : https://developer.sumup.com/
# Sans ces cles : mode simulation (paiements acceptes sans TPE reel)
# -----------------------------------------------
SUMUP_API_KEY=CHANGER_MOI_cle_sumup
SUMUP_MERCHANT_CODE=CHANGER_MOI_merchant_code

# -----------------------------------------------
# EMAIL SMTP (recommande pour tickets + mailing)
# Exemple Gmail : activer "Mot de passe d'application"
# Sans ces cles : simulation (emails loggues, non envoyes)
# -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGER_MOI_email@domaine.fr
SMTP_PASSWORD=CHANGER_MOI_mot_de_passe_application
SMTP_FROM_NAME=Vintiz

# -----------------------------------------------
# SMS TWILIO (optionnel)
# Obtenir sur : https://console.twilio.com/
# Sans ces cles : simulation (SMS loggues, non envoyes)
# -----------------------------------------------
TWILIO_ACCOUNT_SID=CHANGER_MOI_ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGER_MOI_token
TWILIO_FROM=CHANGER_MOI_+33xxxxxxxxx
