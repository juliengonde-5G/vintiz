# ===========================================
# Vintiz V3 — Template de configuration production
# ===========================================
# INSTRUCTIONS:
#   1. Copier ce fichier : cp .env.production.template .env
#   2. Remplir TOUTES les valeurs CHANGER_MOI
#   3. Ne JAMAIS commiter le fichier .env dans git
#   4. Stocker une copie chiffree offline (ex: Bitwarden, 1Password)
#
# Generer SECRET_KEY : openssl rand -hex 32

# -----------------------------------------------
# BASE DE DONNEES (PostgreSQL)
# -----------------------------------------------
POSTGRES_USER=vintiz
POSTGRES_PASSWORD=CHANGER_MOI_mot_de_passe_fort_64chars
POSTGRES_DB=vintiz
DATABASE_URL=postgresql+asyncpg://vintiz:CHANGER_MOI_mot_de_passe_fort_64chars@db:5432/vintiz

# -----------------------------------------------
# CACHE (Redis)
# -----------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------
# SECURITE JWT
# Generer avec : openssl rand -hex 32
# -----------------------------------------------
SECRET_KEY=CHANGER_MOI_generer_avec_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------
# APPLICATION
# -----------------------------------------------
APP_ENV=production
CORS_ORIGINS=https://vintiz.fr,https://app.vintiz.fr,https://api.vintiz.fr

# -----------------------------------------------
# URLS PUBLIQUES (Next.js — build-time args)
# -----------------------------------------------
NEXT_PUBLIC_SITE_URL=https://vintiz.fr
NEXT_PUBLIC_API_URL=https://api.vintiz.fr

# -----------------------------------------------
# SEO / ANALYTICS
# NEXT_PUBLIC_GA_ID : Measurement ID Google Analytics 4 (G-XXXXXXXXXX).
#   Laisser vide = aucun marqueur GA injecte. Quand rempli, GA se charge
#   UNIQUEMENT apres consentement cookies (Consent Mode v2, IP anonymisee).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION : code HTML meta de Search Console.
# GA_MEASUREMENT_ID / GOOGLE_SITE_VERIFICATION : mirror cote API pour le
#   tableau SEO du back-office (/api/seo/status).
# -----------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
PUBLIC_SITE_URL=https://vintiz.fr

# -----------------------------------------------
# IA — ANTHROPIC CLAUDE (OBLIGATOIRE pour IA Booster)
# Obtenir sur : https://console.anthropic.com/
# Sans cette cle : fallback sur donnees statiques
# -----------------------------------------------
ANTHROPIC_API_KEY=CHANGER_MOI_sk-ant-api03-xxxxx

# -----------------------------------------------
# METEO VERNON — OPENWEATHERMAP (recommande)
# Obtenir sur : https://openweathermap.org/api
# Plan gratuit suffisant (60 req/min)
# Sans cette cle : widget meteo indisponible
# -----------------------------------------------
OPENWEATHER_API_KEY=CHANGER_MOI_cle_openweathermap

# -----------------------------------------------
# PAIEMENT CB — SUMUP
# Obtenir sur : https://developer.sumup.com/
#
# SUMUP_ENVIRONMENT : sandbox | production
#   - sandbox    : mode simulation complet (checkouts en memoire, journal live
#                  visible dans Parametres > Paiement, approve/decline manuel).
#                  Aucun appel reel a l'API SumUp.
#   - production : vraie API SumUp (api.sumup.com). Necessite SUMUP_API_KEY
#                  et SUMUP_MERCHANT_CODE, sinon fallback automatique sandbox.
#
# SUMUP_SANDBOX_AUTO_DELAY_SEC : delai (s) avant qu'un checkout sandbox
#   passe automatiquement PENDING -> PAID. 0 = approbation manuelle requise.
# -----------------------------------------------
SUMUP_ENVIRONMENT=sandbox
SUMUP_API_KEY=CHANGER_MOI_cle_sumup
SUMUP_MERCHANT_CODE=CHANGER_MOI_merchant_code
# Optionnel : push direct vers un TPE SumUp Solo specifique (le TPE sonne
# automatiquement, sans ressaisie du montant cote TPE).
# Lister les readers : GET /v0.1/merchants/{MERCHANT_CODE}/readers
SUMUP_READER_ID=
SUMUP_RETURN_URL=
SUMUP_SANDBOX_AUTO_DELAY_SEC=5

# -----------------------------------------------
# EMAIL SMTP (recommande pour tickets + mailing)
# Exemple Gmail : activer "Mot de passe d'application"
# Sans ces cles : simulation (emails loggues, non envoyes)
# -----------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGER_MOI_email@domaine.fr
SMTP_PASSWORD=CHANGER_MOI_mot_de_passe_application
SMTP_FROM_NAME=Vintiz

# -----------------------------------------------
# SMS TWILIO (optionnel)
# Obtenir sur : https://console.twilio.com/
# Sans ces cles : simulation (SMS loggues, non envoyes)
# -----------------------------------------------
TWILIO_ACCOUNT_SID=CHANGER_MOI_ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGER_MOI_token
TWILIO_FROM=CHANGER_MOI_+33xxxxxxxxx

# -----------------------------------------------
# WALLET — APPLE WALLET (.pkpass)
# Pre-requis sur https://developer.apple.com :
#   1. Pass Type ID (ex: pass.fr.vintiz.loyalty)
#   2. Certificat .p12 exporte depuis Keychain (Pass Type ID Certificate)
#   3. Apple WWDR Intermediate cert .pem (telecharger sur apple.com/certificateauthority/)
#   4. Team Identifier de ton compte Apple Developer (10 caracteres)
# Si une seule de ces 4 valeurs est manquante : pas de signature, l'API renvoie
# un payload preview + QR code fallback (utilisable cote front).
# -----------------------------------------------
WALLET_PASS_TYPE_IDENTIFIER=pass.fr.vintiz.loyalty
WALLET_TEAM_IDENTIFIER=CHANGER_MOI_TEAMID0000
WALLET_APPLE_P12_PATH=/opt/vintiz/secrets/wallet/pass.p12
WALLET_APPLE_P12_PASSWORD=CHANGER_MOI_password_p12
WALLET_APPLE_WWDR_PATH=/opt/vintiz/secrets/wallet/AppleWWDRCAG3.pem
# Optionnel : dossier contenant icon.png (29x29), icon@2x.png (58x58), logo.png
WALLET_PASS_ASSETS_DIR=/opt/vintiz/secrets/wallet/assets

# -----------------------------------------------
# WALLET — GOOGLE WALLET (Save-to-Google)
# Pre-requis sur https://pay.google.com/business/console :
#   1. Issuer ID (19 chiffres) attribue par Google
#   2. Service Account JSON avec acces "Wallet Object Issuer"
#   3. LoyaltyClass deja creee cote console (suffix par defaut vintiz_loyalty)
# Si Issuer ou Service Account JSON manquant : QR code fallback uniquement.
# -----------------------------------------------
WALLET_GOOGLE_ISSUER_ID=CHANGER_MOI_19_chiffres
WALLET_GOOGLE_CLASS_SUFFIX=vintiz_loyalty
WALLET_GOOGLE_SERVICE_ACCOUNT_JSON=/opt/vintiz/secrets/wallet/google-sa.json
